# ============================================================
# Kapanin — .gitignore
# ============================================================

# --- Kiro ---
# Ignore local Kiro runtime/user state, but KEEP shared specs
# (.kiro/specs/**) and steering docs in version control so the
# team shares requirements, design, and tasks.
.kiro/cache/
.kiro/logs/
.kiro/user/
.kiro/*.local
.kiro/**/*.local

# --- Environment / secrets ---
.env
.env.*
!.env.example
*.local

# --- Node / backend ---
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
*.swp
