# ============================================================
# Kapanin backend — environment template
# ------------------------------------------------------------
# Copy this file to `.env` and fill in REAL values. The real
# `.env` is git-ignored; this `.env.example` ships placeholders
# ONLY (Requirement 1.7) — never commit real secrets.
#
# MANUAL SETUP (Supabase dashboard — only you can do this):
#   1. Create a project at https://supabase.com/dashboard.
#   2. Project Settings -> API -> "Project URL"  -> SUPABASE_URL
#   3. Project Settings -> API -> secret/service_role key
#      -> SUPABASE_SECRET_KEY  (SERVER-ONLY — never expose to a
#      browser/client and never commit it).
#   4. JWKS URL is derived automatically from SUPABASE_URL as
#      <SUPABASE_URL>/.well-known/jwks.json — leave SUPABASE_JWKS_URL
#      unset unless you need to override it (e.g. a local CLI stack).
# ============================================================

# Supabase project URL (must be a valid https URL).
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-only Supabase secret (service_role) key. Privileged — keep
# out of version control, logs, and client bundles.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Optional: override the derived JWKS endpoint. Leave blank to derive
# it from SUPABASE_URL. Must be a valid https URL when set.
# SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/.well-known/jwks.json

# Port the HTTP server binds to (integer 1-65535). Optional; defaults to 3000.
PORT=3000

# Runtime mode: development | test | production. Optional; defaults to development.
NODE_ENV=development

# Comma-separated list of allowed CORS origins. Optional; defaults to none.
CORS_ORIGINS=http://localhost:5173
